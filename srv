#!/usr/bin/env python3
"""srv — サーバーを「起動のしかた」ごと台帳に登録し、tmux で立てて tailscale serve で出す。

  srv add <名前> --port P [--https-port H] [--cwd D] [--env K=V]... [--env-file F]
          [--path /] [--note メモ] [--fav] [--autostart] [--no-start] -- <コマンド…>
  srv start|stop|restart <名前>   stop は公開も外す(また start すれば同じ URL)
  srv rm <名前>            止めて、公開を外して、台帳から消す
  srv ls [--json]          状態つきの一覧(🟢 動いている / 🟡 公開なし / 🔴 落ちた / ⚪ 止まっている)
  srv logs <名前> [-n 60]  tmux の最後の行
  srv fav <名前> [--off]   お気に入りに入れる/外す(画面の最初のタブ)
  srv share <名前> [--minutes 60] [--off]   trycloudflare で外に公開(時間で自動で止まる)
  srv autostart            autostart のものを全部立てる(ログイン時に)
  srv port [-n 2]          帯(既定 7400-7599)の中の空いているポートを出す
  srv tidy [--dry-run]     宛先の止まった公開をまとめて外す
  srv ui [stop|attach]     一覧の画面を tmux で立てて URL を出す(https :7463)
  srv attach <名前>        tmux に入る(抜けるのは Ctrl-b d)

一覧の画面: srv ui が出す URL(https://<この Mac の名前>.<tailnet>.ts.net:7463/)
"""
import argparse
import json
import os
import shlex
import socket
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import registry  # noqa: E402
import runner  # noqa: E402
import scan  # noqa: E402

MARK = {"up": "🟢", "partial": "🟡", "starting": "⏳", "crashed": "🔴", "down": "⚪", "broken": "❌"}


def die(msg: str, code: int = 1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def cmd_add(a):
    if not a.command:
        die("-- のあとに起動コマンドを書くこと(例: srv add web --port 5190 -- npm run dev)")
    command = a.command[0] if len(a.command) == 1 else shlex.join(a.command)
    env = {}
    for kv in a.env or []:
        k, sep, v = kv.partition("=")
        if not sep:
            die(f"--env は K=V の形で: {kv}")
        env[k] = v
    old = registry.load(a.name)
    entry = {
        "name": a.name,
        "cwd": str(Path(a.cwd or os.getcwd()).expanduser().resolve()),
        "command": command,
        "env": env,
        "env_file": str(Path(a.env_file).expanduser().resolve()) if a.env_file else "",
        "port": a.port,
        "https_port": a.https_port or a.port,
        "path": a.path,
        "note": a.note or (old or {}).get("note", ""),
        "autostart": a.autostart,
        "draft": False,
        # 登録し直してもお気に入りは消さない
        "favorite": a.fav or (old or {}).get("favorite", False),
        # 誰が立てたか。--by が無ければ、前の値か、起動フォルダの名前
        "registered_by": a.by or (old or {}).get("registered_by", "") or Path(a.cwd or os.getcwd()).name,
    }
    if old:
        entry["created_at"] = old.get("created_at")
    try:
        e = registry.save(entry)
    except registry.RegistryError as ex:
        die(str(ex))
    print(("登録し直した" if old else "登録した") + f": {e['name']}")
    if a.no_start:
        return
    if old and runner.has_session(a.name):
        runner.stop(a.name)
    _start(a.name)


def _url(e: dict) -> str:
    host = scan.dns_name()
    return f"https://{host}:{e['https_port']}{e['path']}" if host else ""


def _start(name: str, restart: bool = False):
    try:
        r = runner.restart(name) if restart else runner.start(name)
    except (runner.RunError, registry.RegistryError) as ex:
        die(str(ex))
    print(r["message"], file=sys.stdout if r["ok"] else sys.stderr, flush=True)
    if not r["ok"]:
        if r.get("logs"):
            print("---- ログの最後 ----\n" + r["logs"], file=sys.stderr)
        sys.exit(1)
    print(_url(registry.load(name)))
    if restart:
        import share
        st = share.status(name)
        if st and st.get("url"):
            print(f"外への公開はそのまま: {st['url']}")


def cmd_start(a):
    _start(a.name)


def cmd_stop(a):
    if runner.stop(a.name):
        print("止めた")
        return
    e = registry.load(a.name)
    if e and runner.port_owner(e["port"]):
        die("srv の外で動いているので止めない(立てたところで止めること)")
    print("動いていない")


def cmd_restart(a):
    _start(a.name, restart=True)  # 外への公開(trycloudflare)は止めない


def cmd_rm(a):
    try:
        r = runner.remove(a.name)
    except runner.RunError as ex:
        die(str(ex))
    print(f"消した: {a.name}(公開 :{r['unpublished']} も外した)")


def cmd_ls(a):
    import share

    snap = scan.snapshot()
    shares = share.all_status()
    for s in snap["servers"]:
        s["share"] = shares.get(s.get("name"))
    if a.json:
        print(json.dumps(snap, ensure_ascii=False, indent=2))
        return
    if not snap["servers"]:
        print("(台帳は空)")
    for s in snap["servers"]:
        if s.get("broken"):
            print(f"❌ {s['name']}  台帳が壊れている: {s['broken']}")
            continue
        flags = []
        if s["state"] == "partial":
            flags.append("公開なし")
        elif s["state"] == "crashed":
            flags.append("落ちた。srv logs で見る")
        if s["draft"]:
            flags.append("下書き")
        if s["autostart"]:
            flags.append("自動起動")
        if s.get("favorite"):
            flags.append("★")
        if s.get("share"):
            flags.append(f"🌐 {s['share']['url']}")
        extra = f"  [{' / '.join(flags)}]" if flags else ""
        print(f"{MARK[s['state']]} {s['name']:<20} {s['url'] or ':' + str(s['https_port'])}{extra}")
        if s["note"]:
            print(f"     {s['note']}")
    if snap["unregistered"]:
        print("\n未登録で動いている:")
        for u in snap["unregistered"]:
            urls = " ".join(u["urls"])
            print(f"  :{u['port']:<6} {u['process']:<10} {urls}  ({u['cwd']})")
    if snap["orphans"]:
        print("\n公開だけ残っている(宛先が止まっている):")
        for o in snap["orphans"]:
            print(f"  :{o['https_port']}{o['path']} → {o['target']}" + ("  [funnel]" if o["funnel"] else ""))


def cmd_fav(a):
    try:
        registry.set_favorite(a.name, not a.off)
    except registry.RegistryError as ex:
        die(str(ex))
    print(("お気に入りから外した: " if a.off else "お気に入りに入れた: ") + a.name)


def cmd_share(a):
    import share

    if a.off:
        print("外への公開を止めた" if share.stop(a.name) else "外に出していない")
        return
    try:
        r = share.start(a.name, a.minutes)
    except (runner.RunError, registry.RegistryError) as ex:
        die(str(ex))
    print(f"外に公開した({a.minutes} 分で自動で止まる。誰でも開ける)")
    print(r["url"])


UI_SESSION = "srvlist"


def cmd_ui(a):
    """一覧の画面(server.py)を tmux で立てる。画面は自分で tailscale serve(:7463)を張る。"""
    import time
    import urllib.request

    here = Path(__file__).resolve().parent
    port = int(os.environ.get("SLL_PORT", "7440"))
    https_port = int(os.environ.get("SLL_HTTPS_PORT", "7463"))
    alive = runner._tmux("has-session", "-t", f"={UI_SESSION}").returncode == 0
    if a.action == "stop":
        if alive:
            runner._tmux("kill-session", "-t", f"={UI_SESSION}")
        runner.unpublish(https_port)
        print("畳んだ" if alive else "立っていない")
        return
    if a.action == "attach":
        os.execvp("tmux", ["tmux", "attach", "-t", f"={UI_SESSION}"])
    if not alive:
        owner = runner.port_owner(port)
        if owner:
            die(f"ポート {port} は別のプロセスが使っている({owner['name']} pid {owner['pid']})")
        line = f"cd {shlex.quote(str(here))} && python3 server.py; echo; echo '(止まった。Enter で閉じる)'; read _"
        r = runner._tmux("new-session", "-d", "-s", UI_SESSION, "/bin/zsh", "-c", f"export PATH={shlex.quote(runner.PATH)}:\"$PATH\"; {line}")
        if r.returncode != 0:
            die(f"tmux で起動できない: {r.stderr.strip()}")
    for _ in range(40):
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=1)
            break
        except OSError:
            time.sleep(0.25)
    else:
        die("画面が返事をしない。srv ui attach で様子を見ること")
    host = scan.dns_name()
    print(f"https://{host}:{https_port}/" if host else f"http://127.0.0.1:{port}/")


def cmd_logs(a):
    out = runner.logs(a.name, a.n)
    print(out if out else "(tmux のセッションが無い)")


def cmd_autostart(a):
    # 返事を待ってから公開するので、全部を同時に立てて待つ
    from concurrent.futures import ThreadPoolExecutor

    names = [e["name"] for e in registry.load_all() if not e.get("broken") and e.get("autostart")]

    def one(name):
        try:
            return name, runner.start(name)
        except (runner.RunError, registry.RegistryError) as ex:
            return name, {"ok": False, "message": str(ex)}

    bad = 0
    with ThreadPoolExecutor(max_workers=8) as pool:
        for name, r in pool.map(one, names):
            print(f"{name}: {r['message']}", file=sys.stdout if r["ok"] else sys.stderr)
            bad += 0 if r["ok"] else 1
    sys.exit(1 if bad else 0)


def cmd_port(a):
    used = set(scan.listening())
    used |= set(scan.parse_serve(scan.serve_status()))
    for e in registry.load_all():
        used |= {e.get("port"), e.get("https_port")}

    def bindable(p):
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", p))
                return True
            except OSError:
                return False

    ports = registry.pick_ports(used, a.count, ok=bindable)
    if not ports:
        lo, hi = registry.PORT_RANGE
        die(f"帯 {lo}-{hi} に空きが {a.count} 個ない。SLL_PORT_RANGE を広げること")
    print(" ".join(map(str, ports)))


def cmd_tidy(a):
    snap = scan.snapshot()
    ports = sorted({o["https_port"] for o in snap["orphans"]})
    if not ports:
        print("片付けるものは無い")
        return
    done, refused = [], []
    for hp in ports:
        if a.dry_run:
            print(f"  :{hp}  " + ", ".join(f"{o['path']} → {o['target']}" for o in snap["orphans"] if o["https_port"] == hp))
            continue
        try:
            runner.unpublish_dead(hp, snap)
            done.append(hp)
        except (registry.RegistryError, runner.RunError) as ex:
            refused.append((hp, str(ex)))
    if a.dry_run:
        print(f"外すもの {len(ports)} 個(--dry-run なので何もしていない)")
        return
    print(f"外した {len(done)} 個: " + " ".join(f":{p}" for p in done))
    for hp, why in refused:
        print(f"  外さなかった :{hp}  {why}")


def cmd_attach(a):
    os.execvp("tmux", ["tmux", "attach", "-t", f"={runner.session_name(a.name)}"])


def main():
    p = argparse.ArgumentParser(prog="srv", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("add", help="登録して起動する")
    s.add_argument("name")
    s.add_argument("--port", type=int, required=True, help="サーバーが待つローカルのポート")
    s.add_argument("--https-port", type=int, help="tailnet に出すポート(既定は --port と同じ)")
    s.add_argument("--cwd", help="ここで起動する(既定は今のフォルダ)")
    s.add_argument("--env", action="append", metavar="K=V")
    s.add_argument("--env-file", help="起動前に読む .env(秘密はここに。台帳には場所だけ残る)")
    s.add_argument("--path", default="/", help="開くパスと、起動の確認に使うパス")
    s.add_argument("--note", help="一覧に出すメモ")
    s.add_argument("--autostart", action="store_true", help="ログイン時に立てる")
    s.add_argument("--no-start", action="store_true", help="登録だけ(もう動いているものを後から登録するとき)")
    s.add_argument("--fav", action="store_true", help="お気に入りに入れる(画面の最初のタブに出る)")
    s.add_argument("--by", help="登録したセッションやプロジェクトの名前(既定は起動フォルダの名前)")
    s.set_defaults(f=cmd_add)

    for name, f, h in [("start", cmd_start, "起動"), ("stop", cmd_stop, "停止(公開も外す)"),
                       ("restart", cmd_restart, "再起動"), ("rm", cmd_rm, "止めて公開を外して台帳から消す"),
                       ("attach", cmd_attach, "tmux に入る")]:
        s = sub.add_parser(name, help=h)
        s.add_argument("name")
        s.set_defaults(f=f)

    s = sub.add_parser("fav", help="お気に入りに入れる(--off で外す)")
    s.add_argument("name")
    s.add_argument("--off", action="store_true")
    s.set_defaults(f=cmd_fav)

    s = sub.add_parser("share", help="trycloudflare で外に公開する(--off で止める)")
    s.add_argument("name")
    s.add_argument("--minutes", type=int, default=60, help="この分数で自動で止まる(既定 60)")
    s.add_argument("--off", action="store_true")
    s.set_defaults(f=cmd_share)

    s = sub.add_parser("ui", help="一覧の画面を立てて URL を出す(stop で畳む / attach でログ)")
    s.add_argument("action", nargs="?", choices=["start", "stop", "attach"], default="start")
    s.set_defaults(f=cmd_ui)

    s = sub.add_parser("ls", help="一覧")
    s.add_argument("--json", action="store_true")
    s.set_defaults(f=cmd_ls)

    s = sub.add_parser("logs", help="ログの最後")
    s.add_argument("name")
    s.add_argument("-n", type=int, default=60)
    s.set_defaults(f=cmd_logs)

    s = sub.add_parser("autostart", help="autostart のものを全部立てる")
    s.set_defaults(f=cmd_autostart)

    s = sub.add_parser("port", help="帯(SLL_PORT_RANGE、既定 7400-7599)の中の空いているポートを出す")
    s.add_argument("--count", "-n", type=int, default=1, help="いくつ出すか(中と外で分けるなら 2)")
    s.set_defaults(f=cmd_port)

    s = sub.add_parser("tidy", help="宛先の止まった公開をまとめて外す")
    s.add_argument("--dry-run", action="store_true", help="外すものを出すだけ")
    s.set_defaults(f=cmd_tidy)

    # 起動コマンドは -- のあと。argparse の REMAINDER は名前のあとの --port まで飲むので、先に切り分ける
    argv = sys.argv[1:]
    command = []
    if "--" in argv:
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    a = p.parse_args(argv)
    a.command = command
    try:
        a.f(a)
    except registry.RegistryError as ex:
        die(str(ex))


if __name__ == "__main__":
    main()
